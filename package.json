{
  "name": "@mambalabsdev/mcp-publication-cadence-tracker",
  "version": "1.1.1",
  "description": "MCP server for the Mamba Labs Publication Cadence Tracker actor on Apify. Give it a company domain and it returns how much long-form work that company publishes per month and whether the rate is rising or falling, as flat Clay-ready JSON.",
  "type": "module",
  "bin": {
    "mcp-publication-cadence-tracker": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "content-marketing",
    "publishing",
    "editorial",
    "content-cadence",
    "blog",
    "competitive-intelligence",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-publication-cadence-tracker"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  },
  "mcpName": "com.mambabuilt/mcp-publication-cadence-tracker"
}
